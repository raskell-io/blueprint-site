// The feedback Worker. Deploy with `npx wrangler deploy` from this folder, after `npx wrangler secret put GITHUB_TOKEN`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Same origin as the site: Pages serves the files, this route takes /api/* on the same hostname.
  "routes": [{ "pattern": "example.org/api/*", "zone_name": "example.org" }],
  "vars": {
    "SITE_ORIGIN": "https://example.org",
    "GITHUB_REPO": "your-org/content"
  },
  // Five messages a minute per address.
  "ratelimits": [{ "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true }
}
